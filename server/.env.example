PORT=3000
# Set to the trusted reverse-proxy hop count only when hosted behind Render/Railway/ngrok (commonly 1).
TRUST_PROXY=1
JWT_SECRET=change-me-to-a-long-random-string
# Optional: encryption key for stored contacts and reports (defaults to JWT_SECRET)
ENC_KEY=
# Optional: HIBP gives the most complete breach data (https://haveibeenpwned.com/API/Key). Without it, XposedOrNot (free) is used.
HIBP_API_KEY=
# Optional: enables the web exposure check (free tier: https://brave.com/search/api/)
BRAVE_API_KEY=
# Optional: raises GitHub's username lookup limit from 60 to 5000 per hour
GITHUB_TOKEN=

# Optional: lets you read message-checker feedback at GET /api/admin/feedback (send header x-admin-token). Leave empty to disable.
ADMIN_TOKEN=
